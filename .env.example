PORT=3000

# Supabase: Project Settings > Database > Connection string (usa "Session pooler" si tu red no soporta IPv6)
DATABASE_URL=postgresql://postgres.xxxx:TU_CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# Frase larga y secreta para firmar las sesiones
JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta

# Cuenta de administrador (se crea con: npm run crear-admin)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=pon_una_clave_segura

# Correo(s) que RECIBEN los avisos de adopción (separados por coma)
ADMIN_EMAILS=tucorreo@gmail.com

# Correo que ENVÍA los avisos (Gmail con "Contraseña de aplicación" de 16 letras)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=contraseña_de_aplicacion
